<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 2004+ API set: needed for the now-playing (media session) controls. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ClawControl</RootNamespace>
    <AssemblyName>ClawControl</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>ClawControl.Program</StartupObject>
    <Version>0.1.9</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- AMD's driver settings (Hardware/Adlx.cs) are called through function pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
    <!-- Core Audio wrappers (MIT): master volume, output devices, per-app volume. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="HidSharp" Version="2.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- Intel PresentMon 2.6.0 (MIT, signed by Intel): FPS for the performance overlay. Runs only while FPS is shown. -->
    <None Include="Tools\PresentMon.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
