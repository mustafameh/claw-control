<UserControl x:Class="ClawControl.Features.Performance.PerformancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ClawControl.UI">
    <StackPanel x:Name="Root">
        <!-- Now playing (NowPlayingTile, built in code) goes first; only while an app has a media session. -->

        <!-- Left/right moves volume 2% a step; A (or the arrow) opens the Sound screen. -->
        <ui:FillSlider x:Name="VolumeSlider" Glyph="&#xE995;" ShowMore="True" Minimum="0" Maximum="100" SmallChange="2"
                       ValueChanged="Volume_ValueChanged"/>
        <!-- D-pad left/right moves brightness 5% at a time. -->
        <ui:FillSlider x:Name="BrightnessSlider" Glyph="&#xE706;" TurnGlyph="True" Minimum="0" Maximum="100" SmallChange="5"
                       ValueChanged="Brightness_ValueChanged"/>

        <!-- Power modes as one bar of icons; the line below names the one under the D-pad (or the active one).
             One tile with the Custom sliders and the error line (they move together when editing). -->
        <StackPanel x:Name="PowerBlock">
        <UniformGrid Rows="1" Margin="4,12,4,0">
            <Button x:Name="SuperBatteryButton" Style="{StaticResource ModeButton}" Background="#FF34C759" Content="&#xE8BE;" Click="Mode_Click"/>
            <Button x:Name="BalancedButton" Style="{StaticResource ModeButton}" Background="#FF0A84FF" Content="&#xEC49;" Click="Mode_Click"/>
            <Button x:Name="PerformanceButton" Style="{StaticResource ModeButton}" Background="#FFFF9F0A" Content="&#xE945;" Click="Mode_Click"/>
            <Button x:Name="CustomButton" Style="{StaticResource ModeButton}" Background="#FFBF5AF2" Content="&#xE9E9;" Click="Mode_Click"/>
        </UniformGrid>
        <TextBlock x:Name="ModeCaption" Style="{StaticResource CardDetail}" HorizontalAlignment="Center" Margin="0,5,0,2"/>

        <!-- Only shown in Custom. -->
        <StackPanel x:Name="CustomLimits" Margin="0,4,0,0">
            <ui:FillSlider x:Name="SplSlider" Label="Sustained" ValueChanged="Slider_ValueChanged"/>
            <ui:FillSlider x:Name="SpptSlider" Label="Slow boost" ValueChanged="Slider_ValueChanged"/>
            <ui:FillSlider x:Name="FpptSlider" Label="Fast boost" ValueChanged="Slider_ValueChanged"/>
        </StackPanel>

        <!-- Only shown when something went wrong; the blue icon already says which mode is on. -->
        <TextBlock x:Name="ApplyStatus" Style="{StaticResource CardDetail}" Margin="6,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </StackPanel>
</UserControl>
