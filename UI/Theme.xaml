<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:ClawControl.UI">

    <Color x:Key="AccentColor">#FF4C9AFF</Color>
    <!-- Glass: the window's backdrop is Windows' blurred acrylic; this tint sits on top of it
         (and is what you see when Windows turns transparency off). Surfaces are see-through whites. -->
    <!-- iOS Control Center rules: levels and choices light up white; on/off things light up in
         their own colour (switch green, each mode its own). -->
    <SolidColorBrush x:Key="PanelBrush" Color="#6626201E"/>
    <SolidColorBrush x:Key="CardBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#47FFFFFF"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="BarTrackBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="BarFillBrush" Color="#F7FFFFFF"/>
    <SolidColorBrush x:Key="OnFillBrush" Color="#FF16161A"/>
    <SolidColorBrush x:Key="SwitchOnBrush" Color="#FF34C759"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#4D4C9AFF"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FF06213F"/>
    <SolidColorBrush x:Key="TextBrush" Color="#FFF2F4F8"/>
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#FFA4ACBA"/>
    <!-- D-pad focus is the glass drop (UI/SelectionLens), not a ring: the templates' focus
         borders stay in place (same layout) but draw nothing. -->
    <SolidColorBrush x:Key="FocusBrush" Color="Transparent"/>
    <!-- Glass edges, lit from above like Liquid Glass: bright top edge and top-left corner, faint
         sides, a softer glint at the bottom-right. The panel rim (one device pixel) and, just
         inside it, a wider faint band that gives the glass some thickness. -->
    <LinearGradientBrush x:Key="GlassRimBrush" StartPoint="0.2,-0.05" EndPoint="0.8,1.05">
        <GradientStop Color="#9EFFFFFF" Offset="0"/>
        <GradientStop Color="#47FFFFFF" Offset="0.09"/>
        <GradientStop Color="#1FFFFFFF" Offset="0.3"/>
        <GradientStop Color="#0DFFFFFF" Offset="0.58"/>
        <GradientStop Color="#2EFFFFFF" Offset="0.88"/>
        <GradientStop Color="#80FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PanelBandBrush" StartPoint="0.2,-0.05" EndPoint="0.8,1.05">
        <GradientStop Color="#14FFFFFF" Offset="0"/>
        <GradientStop Color="#09FFFFFF" Offset="0.3"/>
        <GradientStop Color="#04FFFFFF" Offset="0.6"/>
        <GradientStop Color="#0DFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <!-- The slider handle: a sliver of clear glass with a lit edge, like the selection drop. -->
    <SolidColorBrush x:Key="HandleFillBrush" Color="#29FFFFFF"/>
    <LinearGradientBrush x:Key="HandleRimBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F2FFFFFF" Offset="0"/>
        <GradientStop Color="#73FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LensRimBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E6FFFFFF" Offset="0"/>
        <GradientStop Color="#40FFFFFF" Offset="0.3"/>
        <GradientStop Color="#1AFFFFFF" Offset="0.6"/>
        <GradientStop Color="#73FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LensFillBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1CFFFFFF" Offset="0"/>
        <GradientStop Color="#0AFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <!-- Light caught along the top inside the glass. -->
    <LinearGradientBrush x:Key="PanelSheenBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#17FFFFFF" Offset="0"/>
        <GradientStop Color="#0FFFFFFF" Offset="0.025"/>
        <GradientStop Color="#0AFFFFFF" Offset="0.07"/>
        <GradientStop Color="#00FFFFFF" Offset="0.22"/>
    </LinearGradientBrush>

    <!-- Brand logos (Simple Icons, 24×24). Draw with the Logo style; they take the text colour. -->
